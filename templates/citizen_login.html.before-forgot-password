<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Citizen Login - DisasterShield AI</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e3a5f);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
        }

        .card {
            width: 100%;
            max-width: 420px;
            background: white;
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(0,0,0,.25);
            position: relative;
            z-index: 2;
        }

        h1 {
            margin: 0 0 8px;
            color: #0f172a;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin: 15px 0 7px;
            font-weight: bold;
            color: #334155;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            font-size: 15px;
        }

        button {
            width: 100%;
            margin-top: 22px;
            padding: 14px;
            border: none;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        #message {
            margin-top: 15px;
            padding: 10px;
            border-radius: 8px;
            display: none;
        }

        .error {
            display: block !important;
            background: #fee2e2;
            color: #991b1b;
        }

        .register {
            text-align: center;
            margin-top: 16px;
            padding-top: 15px;
            border-top: 1px solid #e5e7eb;
            color: #64748b;
            font-size: 14px;
        }

        a {
            color: #2563eb;
            font-weight: bold;
            text-decoration: none;
        }

        .navigation {
            text-align: center;
            margin-top: 16px;
        }

        .navigation a {
            margin: 0 8px;
            font-size: 14px;
        }

        /* Footer */
        .site-footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;

            width: 100%;
            min-height: 58px;

            background: rgba(15, 23, 42, 0.96);
            color: #cbd5e1;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;
            padding: 8px 15px;

            border-radius: 0;
            box-shadow: 0 -4px 15px rgba(0,0,0,.18);

            z-index: 10;
        }

        .footer-content {
            width: 100%;
            max-width: 1100px;
            margin: auto;
        }

        .footer-brand {
            color: white;
            font-size: 16px;
            margin-bottom: 3px;
        }

        .site-footer p {
            margin: 3px 0;
            font-size: 11px;
        }

        .footer-description,
        .footer-features {
            display: none;
        }

        .footer-divider {
            display: none;
        }

        .footer-credit {
            color: #e2e8f0 !important;
            font-size: 11px !important;
        }

        .footer-copy {
            color: #64748b !important;
            font-size: 9px !important;
        }

        /* Mobile screen optimization */
        @media (max-width: 600px) {

            body {
                min-height: 100svh;
                padding: 12px;
                padding-top: 18px;
                padding-bottom: 78px;
                align-items: flex-start;
            }

            .card {
                max-width: 100%;
                padding: 20px;
                border-radius: 14px;
                margin-top: 5px;
            }

            h1 {
                font-size: 23px;
                margin-bottom: 5px;
            }

            .subtitle {
                font-size: 13px;
                margin-bottom: 13px;
            }

            label {
                margin: 9px 0 5px;
                font-size: 14px;
            }

            input {
                padding: 10px;
                font-size: 14px;
            }

            button {
                margin-top: 15px;
                padding: 11px;
                font-size: 15px;
            }

            #message {
                margin-top: 10px;
                padding: 8px;
                font-size: 13px;
            }

            .navigation {
                margin-top: 13px;
            }

            .navigation a {
                margin: 0 5px;
                font-size: 13px;
            }

            .register {
                margin-top: 12px;
                padding-top: 12px;
                padding-bottom: 3px;
                font-size: 13px;
            }

            .site-footer {
                min-height: 55px;
                padding: 6px 10px;
            }

            .footer-brand {
                font-size: 14px;
            }

            .footer-credit {
                font-size: 10px !important;
            }

            .footer-copy {
                font-size: 8px !important;
            }
        }

    </style>
</head>

<body>

<div class="card">

    <h1>🛡️ Citizen Login</h1>

    <p class="subtitle">
        Access DisasterShield AI emergency services.
    </p>

    <form id="loginForm">

        <label>Email</label>

        <input
            type="email"
            id="email"
            placeholder="Enter your email"
            required
        >

        <label>Password</label>

        <input
            type="password"
            id="password"
            
            placeholder="Enter your password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

    <div id="message"></div>

    <div class="navigation">

        <a href="/">
            🏠 Home
        </a>

        <a href="/admin/login">
            🛡️ Admin Login
        </a>

    </div>

    <div class="register">

        Don't have an account?
        <a href="/citizen/register">Create account</a>

    </div>

</div>


<!-- Footer -->

<footer class="site-footer">

    <div class="footer-content">

        <div class="footer-brand">
            🛡️ <strong>DisasterShield AI</strong>
        </div>

        <p class="footer-description">
            AI-Powered Disaster Management & Emergency Response Platform
        </p>

        <div class="footer-features">
            Real-time Alerts • GIS Risk Mapping • Citizen Reporting • Emergency Assistance
        </div>

        <div class="footer-divider"></div>

        <p class="footer-credit">
            Design &amp; Deployed by <strong>~Amit</strong>
        </p>

        <p class="footer-copy">
            © 2026 DisasterShield AI • SIH Project
        </p>

    </div>

</footer>


<script>

document.getElementById("loginForm").addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();

        const message =
            document.getElementById("message");

        message.style.display = "none";

        try {

            const response =
                await fetch(
                    "/api/auth/login",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({

                            email:
                                document
                                .getElementById("email")
                                .value
                                .trim(),

                            password:
                                document
                                .getElementById("password")
                                .value

                        })
                    }
                );

            const result =
                await response.json();

            if (!result.success) {

                throw new Error(
                    result.message ||
                    "Login failed"
                );

            }

            if (result.user.role !== "citizen") {

                throw new Error(
                    "This login is for citizens only."
                );

            }

            window.location.href =
                "/citizen";

        } catch (error) {

            message.textContent =
                error.message;

            message.className =
                "error";

        }

    }
);

</script>





<script>
document.addEventListener("DOMContentLoaded", function () {
    setupPasswordEye("password");
});

function setupPasswordEye(id) {
    const input = document.getElementById(id);
    if (!input || input.dataset.eyeReady === "true") return;

    const wrapper = document.createElement("span");

    wrapper.style.position = "relative";
    wrapper.style.display = "block";
    wrapper.style.width = "100%";

    input.parentNode.insertBefore(wrapper, input);
    wrapper.appendChild(input);

    input.style.width = "100%";
    input.style.boxSizing = "border-box";
    input.style.paddingRight = "48px";

    const eye = document.createElement("button");

    eye.type = "button";
    eye.innerHTML = "👁️";
    eye.setAttribute("aria-label", "Show password");

    Object.assign(eye.style, {
        position: "absolute",
        right: "8px",
        top: "50%",
        transform: "translateY(-50%)",
        width: "34px",
        height: "34px",
        padding: "0",
        margin: "0",
        border: "0",
        outline: "none",
        background: "transparent",
        cursor: "pointer",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        fontSize: "18px",
        lineHeight: "1",
        zIndex: "10"
    });

    eye.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();

        if (input.type === "password") {
            input.type = "text";
            eye.innerHTML = "🙈";
            eye.setAttribute("aria-label", "Hide password");
        } else {
            input.type = "password";
            eye.innerHTML = "👁️";
            eye.setAttribute("aria-label", "Show password");
        }
    });

    wrapper.appendChild(eye);
    input.dataset.eyeReady = "true";
}
</script>

</body>
</html>
