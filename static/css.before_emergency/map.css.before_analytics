* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background: #f3f6fa;

    color: #172033;
}


/* =========================
   TOPBAR
========================= */

.topbar {
    background:
        linear-gradient(
            135deg,
            #0f172a,
            #172554
        );

    color: white;

    padding: 16px 22px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;
}

.brand {
    display: flex;

    align-items: center;

    gap: 12px;
}

.brand-icon {
    width: 44px;
    height: 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    background:
        rgba(255,255,255,.10);

    border:
        1px solid
        rgba(255,255,255,.15);

    border-radius: 13px;

    font-size: 24px;
}

.brand h1 {
    margin: 0;

    font-size: 21px;
}

.brand p {
    margin: 4px 0 0;

    color: #cbd5e1;

    font-size: 12px;
}

.top-actions {
    display: flex;

    align-items: center;

    gap: 10px;
}

.live-status {
    display: flex;

    align-items: center;

    gap: 6px;

    background:
        rgba(34,197,94,.14);

    border:
        1px solid
        rgba(34,197,94,.3);

    color: #86efac;

    padding: 7px 10px;

    border-radius: 8px;

    font-size: 11px;

    font-weight: bold;
}

.live-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #22c55e;

    box-shadow:
        0 0 8px #22c55e;
}

.back-btn {
    text-decoration: none;

    color: white;

    background:
        rgba(255,255,255,.10);

    border:
        1px solid
        rgba(255,255,255,.12);

    padding: 9px 13px;

    border-radius: 9px;

    font-size: 13px;

    font-weight: bold;
}

.back-btn:hover {
    background:
        rgba(255,255,255,.18);
}


/* =========================
   RISK BANNER
========================= */

.risk-banner {
    margin: 15px 18px 0;

    padding: 15px 17px;

    background: white;

    border-radius: 14px;

    display: flex;

    align-items: center;

    gap: 13px;

    box-shadow:
        0 3px 12px
        rgba(0,0,0,.07);

    border-left:
        5px solid #64748b;
}

.risk-banner-icon {
    font-size: 28px;
}

.risk-banner-content {
    flex: 1;
}

.risk-banner strong {
    display: block;

    font-size: 16px;
}

.risk-banner-content span {
    display: block;

    margin-top: 4px;

    color: #667085;

    font-size: 13px;
}

.last-update {
    color: #667085;

    font-size: 11px;

    white-space: nowrap;
}

.last-update strong {
    display: inline;

    color: #172033;
}


/* =========================
   STATS
========================= */

.stats {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 13px;

    padding: 15px 18px;
}

.stat-card {
    background: white;

    border-radius: 14px;

    padding: 15px;

    display: flex;

    align-items: center;

    gap: 12px;

    box-shadow:
        0 3px 12px
        rgba(0,0,0,.06);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.stat-card:hover {
    transform: translateY(-2px);

    box-shadow:
        0 6px 18px
        rgba(0,0,0,.09);
}

.stat-icon {
    width: 43px;
    height: 43px;

    flex-shrink: 0;

    border-radius: 11px;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 21px;
}

.blue {
    background: #dbeafe;
}

.orange {
    background: #ffedd5;
}

.red {
    background: #fee2e2;
}

.purple {
    background: #ede9fe;
}

.stat-card span {
    display: block;

    color: #667085;

    font-size: 11px;
}

.stat-card strong {
    display: block;

    margin-top: 4px;

    font-size: 25px;
}


/* =========================
   MAP
========================= */

.map-container {
    position: relative;

    margin: 0 18px 18px;
}

#map {
    width: 100%;

    height: 610px;

    border-radius: 15px;

    overflow: hidden;

    box-shadow:
        0 4px 18px
        rgba(0,0,0,.10);
}

.map-container.fullscreen {
    position: fixed;

    inset: 0;

    z-index: 9999;

    margin: 0;

    background: white;
}

.map-container.fullscreen #map {
    height: 100vh;

    border-radius: 0;
}


/* =========================
   MAP ACTIONS
========================= */

.map-actions {
    position: absolute;

    top: 15px;

    left: 55px;

    z-index: 1000;

    display: flex;

    gap: 8px;
}

.map-action {
    border: none;

    background: white;

    color: #172033;

    padding: 10px 12px;

    border-radius: 9px;

    box-shadow:
        0 2px 9px
        rgba(0,0,0,.22);

    font-weight: bold;

    cursor: pointer;

    font-size: 12px;

    transition:
        transform .15s ease,
        background .15s ease;
}

.map-action:hover {
    background: #f8fafc;
}

.map-action:active {
    transform: scale(.96);
}

.map-action:disabled {
    opacity: .6;

    cursor: wait;
}


/* =========================
   MAP LOADING
========================= */

.map-loading {
    position: absolute;

    top: 70px;

    left: 50%;

    transform: translateX(-50%);

    z-index: 1000;

    background: rgba(15,23,42,.92);

    color: white;

    padding: 9px 13px;

    border-radius: 9px;

    display: none;

    align-items: center;

    gap: 8px;

    font-size: 11px;
}

.loader {
    width: 13px;
    height: 13px;

    border:
        2px solid
        rgba(255,255,255,.35);

    border-top-color: white;

    border-radius: 50%;

    animation:
        spin .7s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}


/* =========================
   LEGEND
========================= */

.legend {
    position: absolute;

    z-index: 1000;

    bottom: 20px;

    right: 15px;

    background: rgba(255,255,255,.96);

    padding: 13px;

    border-radius: 10px;

    box-shadow:
        0 2px 10px
        rgba(0,0,0,.18);

    font-size: 12px;
}

.legend h3 {
    margin: 0 0 9px;

    font-size: 14px;
}

.legend div {
    margin: 6px 0;
}

.legend-dot {
    display: inline-block;

    width: 11px;
    height: 11px;

    border-radius: 50%;

    margin-right: 6px;
}

.legend-dot.risk {
    background: #2563eb;
}

.legend-dot.report {
    background: #f59e0b;
}

.legend-dot.alert {
    background: #dc2626;
}

.legend-dot.location {
    background: #16a34a;
}


/* =========================
   NEARBY ALERTS
========================= */

.nearby-panel,
.risk-overview {
    background: white;

    margin: 0 18px 18px;

    padding: 18px;

    border-radius: 14px;

    box-shadow:
        0 3px 12px
        rgba(0,0,0,.06);
}

.panel-header,
.overview-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;
}

.panel-header h2,
.overview-header h2 {
    margin: 0;

    font-size: 18px;
}

.panel-header p,
.overview-header p {
    margin: 4px 0 0;

    color: #667085;

    font-size: 12px;
}

.panel-header > span {
    background: #fee2e2;

    color: #991b1b;

    padding: 6px 9px;

    border-radius: 8px;

    font-size: 11px;

    font-weight: bold;
}

.nearby-alert {
    margin-top: 12px;

    padding: 14px;

    border-radius: 11px;

    background: #fff7f7;

    border-left: 4px solid #dc2626;
}

.nearby-alert h3 {
    margin: 0 0 5px;

    font-size: 15px;
}

.nearby-alert p {
    margin: 5px 0;

    font-size: 13px;

    color: #4b5563;
}

.empty {
    margin-top: 12px;

    padding: 16px;

    background: #f8fafc;

    border-radius: 10px;

    color: #667085;

    text-align: center;

    font-size: 13px;
}


/* =========================
   RISK LEVELS
========================= */

.risk-levels {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 12px;

    margin-top: 15px;
}

.risk-level {
    padding: 14px;

    border-radius: 11px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    border-left: 4px solid;
}

.risk-level span {
    font-size: 13px;

    font-weight: bold;
}

.risk-level strong {
    font-size: 21px;
}

.risk-level.critical {
    background: #fef2f2;

    border-color: #dc2626;

    color: #991b1b;
}

.risk-level.high {
    background: #fff7ed;

    border-color: #f97316;

    color: #c2410c;
}

.risk-level.moderate {
    background: #fefce8;

    border-color: #eab308;

    color: #854d0e;
}

.risk-level.normal {
    background: #f0fdf4;

    border-color: #22c55e;

    color: #166534;
}


/* =========================
   POPUP
========================= */

.popup-box {
    min-width: 240px;

    max-width: 320px;
}

.popup-box h3 {
    margin: 0 0 12px;

    font-size: 17px;
}

.popup-row {
    display: flex;

    justify-content: space-between;

    gap: 10px;

    padding: 7px 0;

    border-bottom:
        1px solid #e5e7eb;

    font-size: 12px;
}

.popup-row span {
    color: #667085;
}

.popup-row strong {
    text-align: right;

    word-break: break-word;
}

.leaflet-popup-content {
    margin: 13px 15px;
}


/* =========================
   FOOTER
========================= */

.footer {
    padding: 20px;

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 10px;

    flex-wrap: wrap;

    color: #667085;

    font-size: 11px;
}

.footer strong {
    color: #172033;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    .stats {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .risk-levels {
        grid-template-columns:
            repeat(2, 1fr);
    }
}


@media (max-width: 700px) {

    .topbar {
        padding: 12px 13px;
    }

    .brand h1 {
        font-size: 17px;
    }

    .brand p {
        font-size: 10px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;

        font-size: 19px;
    }

    .live-status {
        display: none;
    }

    .back-btn {
        padding: 8px 10px;

        font-size: 11px;
    }

    .risk-banner {
        margin: 10px 10px 0;

        padding: 12px;
    }

    .risk-banner-icon {
        font-size: 24px;
    }

    .risk-banner strong {
        font-size: 14px;
    }

    .risk-banner-content span {
        font-size: 11px;
    }

    .last-update {
        display: none;
    }

    .stats {
        grid-template-columns:
            repeat(2, 1fr);

        gap: 7px;

        padding: 10px;
    }

    .stat-card {
        padding: 10px;

        gap: 8px;
    }

    .stat-icon {
        width: 34px;
        height: 34px;

        font-size: 17px;
    }

    .stat-card span {
        font-size: 9px;
    }

    .stat-card strong {
        font-size: 20px;
    }

    .map-container {
        margin: 0 10px 10px;
    }

    #map {
        height: calc(100vh - 330px);

        min-height: 430px;

        border-radius: 12px;
    }

    .map-actions {
        left: 48px;

        top: 10px;

        gap: 5px;
    }

    .map-action {
        padding: 8px 9px;

        font-size: 10px;
    }

    .legend {
        right: 8px;

        bottom: 10px;

        padding: 9px;

        font-size: 10px;
    }

    .legend h3 {
        font-size: 12px;
    }

    .nearby-panel,
    .risk-overview {
        margin: 0 10px 12px;

        padding: 14px;
    }

    .panel-header h2,
    .overview-header h2 {
        font-size: 15px;
    }

    .risk-levels {
        gap: 7px;
    }

    .risk-level {
        padding: 10px;
    }

    .risk-level span {
        font-size: 11px;
    }

    .risk-level strong {
        font-size: 18px;
    }

    .footer {
        padding: 15px;

        flex-direction: column;

        gap: 4px;
    }
}

/* =========================
   RISK MARKER ANIMATION
   ========================= */

.risk-critical {
    animation: riskPulse 1.4s infinite;
}

.risk-high {
    animation: riskPulse 2s infinite;
}

@keyframes riskPulse {

    0% {
        opacity: 1;
    }

    50% {
        opacity: .45;
    }

    100% {
        opacity: 1;
    }
}


/* =========================
   LEAFLET CONTROL POLISH
   ========================= */

.leaflet-control-layers {
    background: rgba(255,255,255,.96) !important;
    border-radius: 12px !important;
    padding: 6px !important;
    box-shadow: 0 4px 18px rgba(0,0,0,.18) !important;
}

.leaflet-control-layers label {
    padding: 4px 2px;
    font-size: 13px;
}

.leaflet-control-layers-separator {
    margin: 6px 0 !important;
}


/* =========================
   MAP POPUP IMPROVEMENT
   ========================= */

.popup-box h3 {
    font-weight: 700;
}

.popup-row:last-child {
    border-bottom: none;
}


/* =========================
   MOBILE RISK MARKERS
   ========================= */

@media (max-width: 700px) {

    .leaflet-control-layers {
        font-size: 11px;
    }

}

/* =========================
   RISK HEATMAP INFO
   ========================= */

.heatmap-info {
    background: rgba(255,255,255,.96);
    padding: 10px 12px;
    border-radius: 10px;
    box-shadow: 0 2px 10px rgba(0,0,0,.18);
    font-size: 12px;
    line-height: 1.5;
}

.heatmap-gradient {
    width: 150px;
    height: 10px;
    margin-top: 6px;
    border-radius: 10px;
    background: linear-gradient(
        to right,
        #22c55e,
        #eab308,
        #f97316,
        #dc2626
    );
}

.heatmap-labels {
    width: 150px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #667085;
}

/* =========================
   NEARBY DANGER SYSTEM
   ========================= */

.nearby-status-card {
    margin-top: 14px;
    padding: 16px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 13px;
    border: 1px solid #e5e7eb;
}

.nearby-status-card.safe {
    background: #f0fdf4;
    border-color: #bbf7d0;
}

.nearby-status-card.location-needed {
    background: #eff6ff;
    border-color: #bfdbfe;
}

.nearby-status-icon {
    font-size: 28px;
}

.nearby-status-card strong {
    display: block;
    font-size: 15px;
}

.nearby-status-card p {
    margin: 4px 0;
    font-size: 13px;
    color: #4b5563;
}

.nearby-status-card small {
    color: #667085;
    font-size: 11px;
}


/* ALERT CARD */

.nearby-alert {
    position: relative;
    margin-top: 12px;
    padding: 15px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #fecaca;
    border-left: 5px solid #dc2626;
}

.nearby-alert.warning {
    border-color: #fed7aa;
    border-left-color: #f97316;
    background: #fff7ed;
}

.nearby-alert.danger {
    border-color: #fecaca;
    border-left-color: #dc2626;
    background: #fff7f7;
}

.nearby-alert-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.nearby-alert-level {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .4px;
}

.nearby-distance {
    background: #fee2e2;
    color: #991b1b;
    padding: 5px 8px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

.nearby-alert h3 {
    margin: 4px 0 8px;
    font-size: 16px;
}

.nearby-alert p {
    margin: 5px 0;
    color: #4b5563;
    font-size: 13px;
    line-height: 1.45;
}

.nearby-alert-meta {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    font-size: 11px;
    color: #667085;
}

.view-alert-btn {
    border: none;
    background: #111827;
    color: white;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.view-alert-btn:active {
    transform: scale(.96);
}


/* MOBILE */

@media (max-width: 700px) {

    .nearby-alert-meta {
        align-items: flex-start;
        flex-direction: column;
    }

    .view-alert-btn {
        width: 100%;
    }

}
