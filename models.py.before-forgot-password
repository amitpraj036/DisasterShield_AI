    __table_args__ = (
        db.UniqueConstraint(
            "user_id",
            "alert_id",
            name="uq_safety_alert_event_user_alert"
        ),
    )

    def __repr__(self):
        return f"<SafetyAlertEvent user={self.user_id} alert={self.alert_id}>"



