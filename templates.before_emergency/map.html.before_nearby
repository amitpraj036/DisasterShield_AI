<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <title>DisasterShield AI - Emergency GIS</title>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/map.css') }}"
    >
</head>

<body>

<header class="topbar">

    <div class="brand">

        <div class="brand-icon">
            🛡️
        </div>

        <div>
            <h1>DisasterShield AI</h1>

            <p>
                Live Disaster Risk & Emergency Intelligence
            </p>
        </div>

    </div>

    <div class="top-actions">

        <span class="live-status">
            <span class="live-dot"></span>
            LIVE
        </span>

        <a
            href="/citizen"
            class="back-btn"
        >
            ← Dashboard
        </a>

    </div>

</header>


<!-- =========================
     RISK STATUS
========================= -->

<section
    class="risk-banner"
    id="riskBanner"
>

    <div
        class="risk-banner-icon"
        id="riskBannerIcon"
    >
        🛡️
    </div>

    <div class="risk-banner-content">

        <strong id="riskBannerTitle">
            Checking Risk...
        </strong>

        <span id="riskBannerText">
            Loading live disaster information...
        </span>

    </div>

    <div class="last-update">
        Updated:
        <strong id="lastUpdated">
            --:--
        </strong>
    </div>

</section>


<!-- =========================
     STATISTICS
========================= -->

<section class="stats">

    <div class="stat-card">

        <div class="stat-icon blue">
            📡
        </div>

        <div class="stat-content">

            <span>
                Risk Observations
            </span>

            <strong id="riskCount">
                0
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon orange">
            📍
        </div>

        <div class="stat-content">

            <span>
                Verified Reports
            </span>

            <strong id="reportCount">
                0
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon red">
            🚨
        </div>

        <div class="stat-content">

            <span>
                Active Alerts
            </span>

            <strong id="alertCount">
                0
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon purple">
            ⚠️
        </div>

        <div class="stat-content">

            <span>
                Highest Risk Score
            </span>

            <strong id="highestRisk">
                0
            </strong>

        </div>

    </div>

</section>


<!-- =========================
     MAP
========================= -->

<main class="map-container">

    <div id="map"></div>


    <div class="map-actions">

        <button
            id="locateBtn"
            class="map-action"
            type="button"
        >
            📍 My Location
        </button>

        <button
            id="refreshBtn"
            class="map-action"
            type="button"
        >
            🔄 Refresh
        </button>

        <button
            id="fullscreenBtn"
            class="map-action"
            type="button"
        >
            ⛶ Fullscreen
        </button>

    </div>


    <div class="map-loading" id="mapLoading">

        <div class="loader"></div>

        <span>
            Loading disaster data...
        </span>

    </div>


    <!-- LEGEND -->

    <div class="legend">

        <h3>
            Map Legend
        </h3>

        <div>
            <span class="legend-dot risk"></span>
            Risk Observation
        </div>

        <div>
            <span class="legend-dot report"></span>
            Verified Report
        </div>

        <div>
            <span class="legend-dot alert"></span>
            Active Alert
        </div>

        <div>
            <span class="legend-dot location"></span>
            Your Location
        </div>

    </div>

</main>


<!-- =========================
     NEARBY ALERTS
========================= -->

<section class="nearby-panel">

    <div class="panel-header">

        <div>

            <h2>
                🚨 Nearby Emergency Alerts
            </h2>

            <p>
                Active alerts detected around your location
            </p>

        </div>

        <span id="nearbyCount">
            0 nearby
        </span>

    </div>


    <div id="nearbyAlerts">

        <div class="empty">
            📍 Use "My Location" to check nearby alerts.
        </div>

    </div>

</section>


<!-- =========================
     RISK OVERVIEW
========================= -->

<section class="risk-overview">

    <div class="overview-header">

        <div>

            <h2>
                📊 Risk Intelligence
            </h2>

            <p>
                Current disaster risk observations
            </p>

        </div>

    </div>


    <div class="risk-levels">

        <div class="risk-level critical">

            <span>
                Critical
            </span>

            <strong id="criticalCount">
                0
            </strong>

        </div>


        <div class="risk-level high">

            <span>
                High
            </span>

            <strong id="highCount">
                0
            </strong>

        </div>


        <div class="risk-level moderate">

            <span>
                Moderate
            </span>

            <strong id="moderateCount">
                0
            </strong>

        </div>


        <div class="risk-level normal">

            <span>
                Normal
            </span>

            <strong id="normalCount">
                0
            </strong>

        </div>

    </div>

</section>


<footer class="footer">

    <strong>
        🛡️ DisasterShield AI
    </strong>

    <span>
        Citizen Emergency & Disaster Management System
    </span>

    <span>
        Created for safer communities
    </span>

</footer>


<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<script
    src="{{ url_for('static', filename='js/map.js') }}"
></script>

</body>

</html>
