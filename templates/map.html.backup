<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    >

    <meta name="theme-color" content="#0b1220">

    <title>DisasterShield AI - Live GIS</title>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/map.css') }}"
    >
</head>

<body>

<!-- ================= HEADER ================= -->

<header class="topbar">

    <div class="brand">

        <div class="brand-icon">
            🛡️
        </div>

        <div class="brand-text">

            <h1>DisasterShield AI</h1>

            <p>
                Live Disaster Risk Intelligence
            </p>

        </div>

    </div>

    <div class="header-actions">

        <span class="online-status">
            <span class="online-dot"></span>
            LIVE
        </span>

        <a
            href="/citizen"
            class="header-btn"
        >
            ← Dashboard
        </a>

    </div>

</header>


<main class="page">


<!-- ================= RISK BANNER ================= -->

<section
    class="risk-banner safe"
    id="riskBanner"
>

    <div
        class="risk-banner-icon"
        id="riskBannerIcon"
    >
        🟢
    </div>

    <div class="risk-banner-content">

        <strong id="riskBannerTitle">
            Checking Disaster Risk
        </strong>

        <span id="riskBannerText">
            Loading live information...
        </span>

    </div>

    <span
        class="risk-badge"
        id="riskBadge"
    >
        SCANNING
    </span>

</section>


<!-- ================= STATISTICS ================= -->

<section class="stats">

    <div class="stat-card">

        <div class="stat-icon blue">
            📡
        </div>

        <div class="stat-content">

            <span>
                Risk Observations
            </span>

            <strong id="riskCount">
                0
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon orange">
            📍
        </div>

        <div class="stat-content">

            <span>
                Verified Reports
            </span>

            <strong id="reportCount">
                0
            </strong>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon red">
            🚨
        </div>

        <div class="stat-content">

            <span>
                Active Alerts
            </span>

            <strong id="alertCount">
                0
            </strong>

        </div>

    </div>

</section>


<!-- ================= MAP CARD ================= -->

<section class="map-card">

    <div class="map-header">

        <div>

            <h2>
                🗺️ Live Disaster Map
            </h2>

            <p id="mapStatus">
                Connecting to live database...
            </p>

        </div>

        <div class="map-header-actions">

            <button
                id="locateBtn"
                class="map-btn location-btn"
                type="button"
            >
                📍 My Location
            </button>

            <button
                id="refreshBtn"
                class="map-btn"
                type="button"
            >
                🔄 Refresh
            </button>

        </div>

    </div>


    <div class="map-container">

        <div id="map"></div>

        <div class="map-loading" id="mapLoading">

            <div class="spinner"></div>

            <span>
                Loading live map data...
            </span>

        </div>

        <div class="map-location-status" id="locationStatus">
            Location not detected
        </div>

        <div class="map-legend">

            <div class="legend-title">
                MAP LEGEND
            </div>

            <div class="legend-item">
                <span class="legend-dot risk"></span>
                Risk Observation
            </div>

            <div class="legend-item">
                <span class="legend-dot report"></span>
                Verified Report
            </div>

            <div class="legend-item">
                <span class="legend-dot alert"></span>
                Emergency Zone
            </div>

            <div class="legend-item">
                <span class="legend-dot user"></span>
                Your Location
            </div>

        </div>

    </div>


    <div class="map-footer">

        <span>
            🛰️ Data source: DisasterShield AI
        </span>

        <span id="lastUpdated">
            Last updated: --
        </span>

    </div>

</section>


<!-- ================= NEARBY ALERTS ================= -->

<section class="nearby-panel">

    <div class="panel-header">

        <div>

            <span class="section-label">
                SAFETY MONITOR
            </span>

            <h2>
                🚨 Nearby Emergency Alerts
            </h2>

        </div>

        <span
            id="nearbyCount"
            class="nearby-count"
        >
            0 nearby
        </span>

    </div>


    <div
        id="nearbyAlerts"
        class="nearby-list"
    >

        <div class="empty-state">
            <div class="empty-icon">
                📡
            </div>

            <strong>
                Checking nearby alerts
            </strong>

            <p>
                Detecting your location...
            </p>

        </div>

    </div>

</section>


<!-- ================= QUICK ACTIONS ================= -->

<section class="quick-actions">

    <a
        href="/citizen/report"
        class="quick-action report-action"
    >

        <span class="quick-icon">
            🚨
        </span>

        <span>
            <strong>
                Report Disaster
            </strong>

            <small>
                Submit an emergency report
            </small>
        </span>

        <b>
            →
        </b>

    </a>


    <a
        href="/citizen"
        class="quick-action dashboard-action"
    >

        <span class="quick-icon">
            🏠
        </span>

        <span>
            <strong>
                Citizen Dashboard
            </strong>

            <small>
                View your reports and alerts
            </small>
        </span>

        <b>
            →
        </b>

    </a>

</section>


</main>


<!-- ================= FOOTER ================= -->

<footer class="footer">

    <span>
        🛡️ DisasterShield AI
    </span>

    <span>
        Created by ~ Amit
    </span>

</footer>


<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<script
    src="{{ url_for('static', filename='js/map.js') }}"
></script>

</body>
</html>
