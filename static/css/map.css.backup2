* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}


/* =========================
   TOPBAR
   ========================= */

.topbar {
    background: #101828;
    color: white;
    padding: 15px 22px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 15px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(255,255,255,.1);
    border-radius: 12px;

    font-size: 23px;
}

.brand h1 {
    margin: 0;
    font-size: 21px;
}

.brand p {
    margin: 4px 0 0;
    color: #b8c2d1;
    font-size: 13px;
}

.back-btn {
    text-decoration: none;
    color: white;

    background: rgba(255,255,255,.1);

    padding: 10px 15px;
    border-radius: 9px;

    font-size: 14px;
    font-weight: bold;
}


/* =========================
   RISK BANNER
   ========================= */

.risk-banner {
    margin: 15px 18px 0;

    padding: 14px 16px;

    background: white;

    border-radius: 13px;

    display: flex;
    align-items: center;
    gap: 13px;

    box-shadow: 0 2px 10px rgba(0,0,0,.07);

    border-left: 5px solid #64748b;
}

.risk-banner-icon {
    font-size: 28px;
}

.risk-banner strong {
    display: block;
    font-size: 16px;
}

.risk-banner span {
    display: block;
    margin-top: 3px;

    color: #667085;
    font-size: 13px;
}


/* =========================
   STATS
   ========================= */

.stats {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;

    padding: 15px 18px;
}

.stat-card {
    background: white;

    border-radius: 13px;

    padding: 15px;

    display: flex;
    align-items: center;

    gap: 12px;

    box-shadow:
        0 2px 10px rgba(0,0,0,.07);
}

.stat-icon {
    width: 42px;
    height: 42px;

    border-radius: 11px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 21px;
}

.blue {
    background: #dbeafe;
}

.orange {
    background: #ffedd5;
}

.red {
    background: #fee2e2;
}

.stat-card span {
    display: block;

    color: #667085;

    font-size: 12px;
}

.stat-card strong {
    display: block;

    margin-top: 4px;

    font-size: 25px;
}


/* =========================
   MAP
   ========================= */

.map-container {
    position: relative;

    margin: 0 18px 18px;
}

#map {
    width: 100%;
    height: 610px;

    border-radius: 15px;

    overflow: hidden;

    box-shadow:
        0 3px 15px rgba(0,0,0,.1);
}


/* =========================
   MAP ACTIONS
   ========================= */

.map-actions {
    position: absolute;

    top: 15px;
    left: 55px;

    z-index: 1000;

    display: flex;

    gap: 8px;
}

.map-action {
    border: none;

    background: white;

    padding: 10px 13px;

    border-radius: 9px;

    box-shadow:
        0 2px 8px rgba(0,0,0,.2);

    font-weight: bold;

    cursor: pointer;
}

.map-action:active {
    transform: scale(.96);
}


/* =========================
   LEGEND
   ========================= */

.legend {
    position: absolute;

    z-index: 1000;

    bottom: 20px;
    right: 15px;

    background: white;

    padding: 13px;

    border-radius: 10px;

    box-shadow:
        0 2px 10px rgba(0,0,0,.18);

    font-size: 12px;
}

.legend h3 {
    margin: 0 0 9px;

    font-size: 14px;
}

.legend div {
    margin: 6px 0;
}

.legend-dot {
    display: inline-block;

    width: 11px;
    height: 11px;

    border-radius: 50%;

    margin-right: 6px;
}

.legend-dot.risk {
    background: #2563eb;
}

.legend-dot.report {
    background: #f59e0b;
}

.legend-dot.alert {
    background: #dc2626;
}


/* =========================
   NEARBY ALERTS
   ========================= */

.nearby-panel {
    background: white;

    margin: 0 18px 25px;

    padding: 18px;

    border-radius: 14px;

    box-shadow:
        0 2px 10px rgba(0,0,0,.07);
}

.panel-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;
}

.panel-header h2 {
    margin: 0;

    font-size: 18px;
}

.panel-header span {
    background: #fee2e2;

    color: #991b1b;

    padding: 6px 9px;

    border-radius: 8px;

    font-size: 12px;

    font-weight: bold;
}

.nearby-alert {
    margin-top: 12px;

    padding: 13px;

    border-radius: 10px;

    background: #fff7f7;

    border-left: 4px solid #dc2626;
}

.nearby-alert h3 {
    margin: 0 0 5px;

    font-size: 15px;
}

.nearby-alert p {
    margin: 4px 0;

    font-size: 13px;

    color: #4b5563;
}

.empty {
    margin-top: 12px;

    padding: 15px;

    background: #f8fafc;

    border-radius: 10px;

    color: #667085;

    text-align: center;

    font-size: 13px;
}


/* =========================
   POPUP
   ========================= */

.popup-box {
    min-width: 240px;
    max-width: 320px;
}

.popup-box h3 {
    margin: 0 0 12px;

    font-size: 17px;
}

.popup-row {
    display: flex;

    justify-content: space-between;

    gap: 10px;

    padding: 7px 0;

    border-bottom:
        1px solid #e5e7eb;

    font-size: 12px;
}

.popup-row span {
    color: #667085;
}

.popup-row strong {
    text-align: right;

    word-break: break-word;
}

.leaflet-popup-content {
    margin: 13px 15px;
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

    .topbar {
        padding: 13px 14px;
    }

    .brand h1 {
        font-size: 17px;
    }

    .brand p {
        font-size: 11px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        font-size: 19px;
    }

    .back-btn {
        padding: 8px 10px;
        font-size: 12px;
    }

    .risk-banner {
        margin: 10px 10px 0;
    }

    .stats {
        grid-template-columns: 1fr 1fr 1fr;

        gap: 7px;

        padding: 10px;
    }

    .stat-card {
        padding: 10px;

        display: block;

        text-align: center;
    }

    .stat-icon {
        margin: auto;

        width: 32px;
        height: 32px;

        font-size: 16px;
    }

    .stat-card span {
        margin-top: 6px;

        font-size: 9px;
    }

    .stat-card strong {
        font-size: 20px;
    }

    .map-container {
        margin: 0 10px 10px;
    }

    #map {
        height: calc(100vh - 285px);

        min-height: 430px;

        border-radius: 12px;
    }

    .map-actions {
        left: 50px;
        top: 10px;
    }

    .map-action {
        padding: 8px 10px;
        font-size: 11px;
    }

    .legend {
        right: 8px;
        bottom: 10px;

        padding: 9px;

        font-size: 10px;
    }

    .legend h3 {
        font-size: 12px;
    }

    .nearby-panel {
        margin: 0 10px 15px;

        padding: 14px;
    }

    .panel-header h2 {
        font-size: 15px;
    }

}
